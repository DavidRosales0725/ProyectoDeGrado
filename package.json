{
  "name": "proyecto",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "co.sena.tiendaapp",
    "productName": "TiendaApp",
    "directories": { "output": "dist" },
    "files": ["**/*", "!scripts/**", "!dist/**", "!*.md", "!*.db", "!build/LEEME.txt"],
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.18.0"
  }
}
